# Copy to ~/.config/life-on-rails/env (mode 0600) and fill in. Never commit filled values.
# systemd reads this file too, and it does not strip trailing comments:
# keep every comment on its own line.

# Unix socket + peer auth. Never 127.0.0.1: that asks for a password.
DATABASE_URL=postgres:///life_on_rails?host=/var/run/postgresql
# Used only by `pnpm test:db`. The database name must contain "test".
LOR_TEST_DATABASE_URL=postgres:///life_on_rails_test?host=/var/run/postgresql

LOR_BIND=127.0.0.1
LOR_PORT=3847
# The identity-checked listener behind `tailscale serve`, and the one login it accepts.
LOR_SERVE_PORT=3848
LOR_OWNER_LOGIN=

LOR_TZ=America/Los_Angeles
# The owner's waking day.
LOR_WAKE_START=08:00
LOR_WAKE_END=22:00
LOR_SCORING_WEEKS=2

LOR_CALENDAR_POLL_S=300
LOR_TASKS_POLL_S=900
LOR_CONTACTS_POLL_S=21600
# Country calling code for phone numbers written without one.
LOR_PHONE_COUNTRY_CODE=1

# Bearer for /api/v1; the lor CLI reads it from this file.
LOR_AGENT_TOKEN=

# T3 webhook that delivers new mail to the agent's main thread. A secret.
LOR_WAKE_URL=
LOR_WAKE_QUIET_S=180
LOR_WAKE_MAX_S=900

# The TRMNL X on the wall. Its listener binds this address (empty: off) and serves only the
# firmware's /api/setup, /api/display, /api/log and the image. 0.0.0.0 survives a DHCP change;
# point the device at http://<this box's LAN address>:<port>.
LOR_TRMNL_BIND=
LOR_TRMNL_PORT=3849
# The device's MAC (a refused setup logs it) and the key it is handed: openssl rand -hex 24
LOR_TRMNL_MAC=
LOR_TRMNL_KEY=

GOOGLE_ACCOUNT=
GOOGLE_OAUTH_CLIENT=/home/supadava/.config/life-on-rails/google-client.json
GOOGLE_TOKEN_FILE=/home/supadava/.config/life-on-rails/google-token.json
# Mail notifications: the topic Gmail publishes to, and LoR's pull subscription on it.
# projects/<project>/topics/<name> and projects/<project>/subscriptions/<name>
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
