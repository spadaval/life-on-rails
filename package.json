{
  "name": "life-on-rails",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite dev --port 3847 --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "google:auth": "tsx scripts/google-auth.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "srvx": "0.11.22",
    "tailwindcss": "4.3.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
