[Unit]
Description=Life on Rails (web, API, jobs)
# Postgres is a system unit and cannot be ordered against from a user unit:
# if it is not up yet, the server exits non-zero and is started again.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/life-on-rails
EnvironmentFile=%h/.config/life-on-rails/env
Environment=NODE_ENV=production
# node by absolute path, not pnpm: a corepack shim would try to download pnpm at start.
ExecStart=%h/.local/opt/node/bin/node scripts/serve.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
