[Unit]
Description=Life on Rails Linux activity sensor (on-box only, loopback ingest)
After=network.target lor-web.service
Wants=lor-web.service

[Service]
Type=simple
Restart=on-failure
RestartSec=10
WorkingDirectory=%h/projects/life-on-rails/agents/linux-activity
Environment=PATH=/home/supadava/.local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=LOR_INGEST_URL=http://127.0.0.1:3847/ingest
Environment=LOR_DEVICE=buildbot
EnvironmentFile=%h/.config/life-on-rails/env
ExecStart=/home/supadava/.local/bin/pnpm start

[Install]
WantedBy=default.target
